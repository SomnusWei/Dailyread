# 服务端环境变量示例（部署时复制为 .env 并填写真实值）
NODE_ENV=production
PORT=3001

# MySQL 配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=dailyread_user
DB_PASSWORD=请替换为强密码
DB_NAME=dailyread_db

# JWT 配置
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRES_IN=30d

# CORS 白名单（多个用逗号分隔）
CORS_ORIGIN=*

# 限流配置
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_API_PER_MIN=100

# 运维提示（非应用变量，需在 MySQL 服务端配置）：
# 文章含 audiobase64（m4a/AAC，base64 内嵌，单条建议 < 2MB），
# 需将 MySQL 的 max_allowed_packet 调至 ≥ 16M，避免大 payload 写入失败。
# 临时设置：SET GLOBAL max_allowed_packet=16*1024*1024;
# 永久设置：在 my.cnf / my.ini 的 [mysqld] 段添加 max_allowed_packet=16M 后重启 MySQL。
